{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feature List",
  "description": "机器可读的功能清单。每条 feature 的三元结构：(行为, 验证方法, 状态)。",
  "type": "object",
  "required": ["features"],
  "properties": {
    "project": {
      "type": "string",
      "description": "项目名"
    },
    "last_updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "最后更新日期 YYYY-MM-DD"
    },
    "rules": {
      "type": "object",
      "description": "不可协商的规则声明",
      "properties": {
        "single_active_feature": { "type": "boolean" },
        "passing_requires_evidence": { "type": "boolean" },
        "do_not_skip_verification": { "type": "boolean" }
      }
    },
    "status_legend": {
      "type": "object",
      "description": "状态值的含义"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "priority", "title", "user_visible_behavior", "status", "verification"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+-\\d+$",
            "description": "唯一标识，格式 <area>-<序号>"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "description": "越小越优先"
          },
          "area": {
            "type": "string",
            "description": "功能域"
          },
          "title": {
            "type": "string",
            "description": "短名"
          },
          "user_visible_behavior": {
            "type": "string",
            "description": "从用户视角描述可观察行为"
          },
          "status": {
            "type": "string",
            "enum": ["not_started", "in_progress", "blocked", "passing"]
          },
          "verification": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" },
            "description": "逐步可执行指令数组（不是 shell 命令，是操作步骤）"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" },
            "description": "验证通过后填入：命令 + 结果"
          },
          "notes": {
            "type": "string",
            "description": "自由文本，可记录依赖关系"
          }
        }
      }
    }
  }
}
